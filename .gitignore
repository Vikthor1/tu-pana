# Allowlist-style .gitignore
# Ignore everything by default, then explicitly allow deployment files only.

# ── Ignore everything ──────────────────────────────────
*

# ── Allow deployment files ─────────────────────────────
!index.html
!dify-embed-test.html
!faculty-tedtalk-script.md
!README.md
!.gitignore

# ── Allow modular assets (JS modules + CSS) ─────────────
!assets/
!assets/css/
!assets/css/styles.css
!assets/audio/
!assets/audio/es/
!assets/audio/es/*.mp3
!assets/audio/en/
!assets/audio/en/.gitkeep
!assets/js/
!assets/js/config.js
!assets/js/data.js
!assets/js/genre-template.js
!assets/js/prompts.js
!assets/js/ai-provider.js
!assets/js/storage.js
!assets/js/ui.js
!assets/js/app.js

# ── Allow project documentation ──────────────────────────
!docs/
!docs/**

# ── Allow prompt library ─────────────────────────────────
!prompts/
!prompts/qa-scenarios.md

# ── Allow Cloudflare Worker proxy scaffold ───────────────
!server/
!server/gemini-worker/
!server/gemini-worker/wrangler.toml
!server/gemini-worker/README.md
!server/gemini-worker/src/
!server/gemini-worker/src/index.js

# ── Explicitly ignore internal / private files ─────────
# (belt-and-suspenders in case the allowlist above is overridden)
.DS_Store
.env
.env.*
.dev.vars
.dev.vars.*
node_modules/
package.json
package-lock.json
*.backup
*.backup.*
*.pre-alignment
*.pre-alignment.*
agent-prompt.md
agent-prompt-revised.md
agent-prompt*.md
SYSTEM_MEMORY.md
alignment-assessment.md
award-assessment.md
design-assessment.md
final-assessment.md
*assessment*.md
*-assessment.md
improvements-report.md
stage-revision-plan.md
stress-test-guide.md
stress-test-report.md
stress-test-runner.js
test-server.js
alignment-implementation.md
manual-test-checklist.md
.claude/
